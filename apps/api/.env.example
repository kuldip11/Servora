# API runtime configuration
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (docker-compose exposes PostgreSQL on host port 5434)
DATABASE_URL=postgresql://pos_user:pos_password@localhost:5434/restaurant_pos

# Redis (docker-compose exposes Redis on host port 6380)
REDIS_URL=redis://:redis_password@localhost:6380

# JWT - replace these in real deployments
JWT_SECRET=change-this-development-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-this-refresh-secret
REFRESH_TOKEN_EXPIRES_IN=7d

# Razorpay webhook secret (separate from API key secret)
RAZORPAY_WEBHOOK_SECRET=
