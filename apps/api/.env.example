# Runtime
NODE_ENV=development
PORT=3000
APP_VERSION=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5176
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_SECONDS=60

# PostgreSQL
DATABASE_URL=postgresql://pos_user:pos_password@localhost:5434/restaurant_pos

# Redis
REDIS_URL=redis://:redis_password@localhost:6380

# JWT
JWT_SECRET=change-this-development-secret
JWT_EXPIRES_IN=15m

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


TRUST_PROXY_HOPS=0
METRICS_TOKEN=development-metrics-token-change-me
